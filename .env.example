# ---- Alert channels (fill in at least one; leave the rest blank) --------------
# LINE Official Account (Messaging API). Preferred.
#   1. https://developers.line.biz/console -> your provider -> Messaging API channel
#   2. "Messaging API" tab -> issue a long-lived Channel access token
#   3. LINE_TO = your user ID ("Basic settings" tab -> "Your user ID", starts with U)
#      Add the OA as a friend on your phone first or pushes are rejected.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# Discord: Server settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# ntfy.sh (zero-setup phone push): install the ntfy app, subscribe to a random topic name
NTFY_TOPIC=

# also print alerts to the console (1/0)
ALERT_STDOUT=1

# ---- Polling ---------------------------------------------------------------------
# The site UI shows today + 14 days. Keep 14 unless the site changes.
DAYS_AHEAD=14
# seconds to wait between the 15 per-day requests of one sweep (be polite to the server)
REQUEST_GAP_SEC=2
# seconds to wait after a full sweep before starting the next one
SWEEP_GAP_SEC=5
# where to remember what we've already seen (so restarts don't re-alert)
STATE_FILE=state.json
# send a "currently free" summary when the watcher starts with no saved state (1/0)
ALERT_ON_STARTUP=1
# send a "still alive" ping every N hours (0 = off)
HEARTBEAT_HOURS=0
# alert once if the site has been unreachable for this many minutes
FAIL_ALERT_AFTER_MIN=15

# ---- Optional filters (blank = everything, which is what you asked for) --------
# FILTER_VENUES=LOC001            # LOC001 = Crystal Sports, LOC002 = Crystal Sports G
# FILTER_COURTS=North-1,G South-2
# FILTER_WEEKDAYS=sat,sun
# FILTER_TIME_FROM=17:00          # only slots starting at/after this
# FILTER_TIME_TO=22:00            # only slots starting before this
