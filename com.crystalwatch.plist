<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd agent: keeps the watcher running on your Mac while it is awake.
     cp com.crystalwatch.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.crystalwatch.plist
     (edit the two /Users/YOU paths first; logs go to crystal-watch.log) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crystalwatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOU/crystal-watch/watcher.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOU/crystal-watch</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/crystal-watch/crystal-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/crystal-watch/crystal-watch.log</string>
</dict>
</plist>
