# systemd unit for a Linux VPS / Raspberry Pi
#   sudo cp crystal-watch.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now crystal-watch
#   journalctl -u crystal-watch -f
[Unit]
Description=Crystal Sports tennis court cancellation watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/crystal-watch
ExecStart=/usr/bin/python3 /opt/crystal-watch/watcher.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
